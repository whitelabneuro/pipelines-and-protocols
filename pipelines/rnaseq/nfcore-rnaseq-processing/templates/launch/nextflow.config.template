/*
 White Lab project-facing Nextflow configuration template

 Copy this file into a live CREATE project launch directory as:

     nextflow.config

 Edit only if project-specific settings are needed.

 Reusable workflow defaults remain documented in:

 - configs/nextflow/create.config
 - configs/params/base_params.yaml
*/

process {
    executor = 'slurm'
}

singularity {
    enabled = true
    autoMounts = true
}

executor {
    queueSize = 50
}
